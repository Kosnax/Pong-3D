<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>Lobbies • 3D Pong</title>
        <link rel="stylesheet" href="/index.css" />
        <link rel="stylesheet" href="/lobbies.css" />
	</head>
	<body>
		<h1 class="game-title"><span>3D</span> <span>Pong</span></h1>
		<section class="landing-intro" aria-labelledby="quick-start-title">
			<p class="eyebrow">FAST, PHYSICS-DRIVEN MULTIPLAYER</p>
			<h2 id="quick-start-title">Defend your goal from every angle.</h2>
			<p>Create a lobby, invite a friend, or jump straight into matchmaking.</p>
		</section>

		<div>
			<% if (user) { %>
				<div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 1rem; flex-wrap: wrap;">
					<a href="/user" style="flex-grow: 1" class="link-button">
						Logged in as <%= user.display_name %> (<%= user.elo %>) — My Profile
					</a>
					<a href="/leaderboard" class="link-button">Leaderboard</a>
					<button onclick="logout()" style="width: auto; padding: 0.5rem 1rem;">
						Log out
					</button>
				</div>
			<% } else { %>
				<div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 1rem; flex-wrap: wrap;">
					<a class="link-button" style="flex-grow: 1" href="/auth/google">Log in with Google</a>
					<a class="link-button" href="/leaderboard">Leaderboard</a>
				</div>
			<% } %>
		</div>

		<% if (user) { %>
			<h2 class="h2-but-h1">Lobbies</h2>

			<div class="card" style="display: flex; flex-direction: column; gap: 1.5rem;">
				<p id="lobby-status" role="status" aria-live="polite"></p>
				<div>
					<button id="random-lobby-button" style="display: block; width: 100%; margin-bottom: 1rem">
						Start Random Matchmaking
					</button>
					<input id="name-field" placeholder="Lobby name" style="display: block; width: 100%; margin-bottom: 1rem" />
					<div class="lobby-option">
						<span>Lobby visibility</span>
						<div class="visibility-buttons">
							<button id="create-public-button" class="visibility-button active">Public</button>
							<button id="create-private-button" class="visibility-button">Private</button>
						</div>
					</div>
					<div class="lobby-option">
						<span>Number of lives</span>
						<input id="create-lives" type="number" value="7" min="1" />
					</div>
					<button id="create-button" style="display: block; width: 100%">Create Lobby</button>
				</div>

				<div>
					<input id="code-field" placeholder="Join Code" style="display: block; width: 100%; margin-bottom: 1rem" />
					<button id="join-button" style="display: block; width: 100%">Join</button>
				</div>
			</div>

			<div class="card">
				<h2>Open Lobbies</h2>
				<div id="lobbies-container">
					<p>Refreshing...</p>
				</div>
			</div>
		<% } %>

		<script>
			function logout() {
				fetch('/auth/logout', { method: 'POST', credentials: 'same-origin' })
					.then(() => {
						window.location.reload();
					});
			}

			<% if (user) { %>
			const nameField = document.getElementById('name-field');
			const createPublicButton = document.getElementById('create-public-button');
			const createPrivateButton = document.getElementById('create-private-button');
			const createLives = document.getElementById('create-lives');
			const randomLobbyButton = document.getElementById('random-lobby-button');
			const createButton = document.getElementById('create-button');
			const lobbyStatus = document.getElementById('lobby-status');
			const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, character => ({
				'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
			}[character]));

			let lobbyIsPublic = true;
			const setLobbyStatus = (message, isError = false) => {
				lobbyStatus.textContent = message;
				lobbyStatus.classList.toggle('error', isError);
			};
			const setLobbyVisibility = (isPublic) => {
				lobbyIsPublic = isPublic;
				createPublicButton.classList.toggle('active', isPublic);
				createPrivateButton.classList.toggle('active', !isPublic);
			};
			createPublicButton.addEventListener('click', (e) => {
				e.preventDefault();
				setLobbyVisibility(true);
			});
			createPrivateButton.addEventListener('click', (e) => {
				e.preventDefault();
				setLobbyVisibility(false);
			});

			async function createLobbyAndRedirect(isPublic = lobbyIsPublic) {
				createButton.disabled = true;
				randomLobbyButton.disabled = true;
				setLobbyStatus('Creating lobby...');
				try {
					const res = await fetch('/api/lobbies', {
						method: 'POST',
						body: JSON.stringify({
							name: nameField.value.trim() || undefined,
							isPublic,
							lives: Number.parseInt(createLives.value, 10)
						}),
						headers: { 'Content-Type': 'application/json' }
					});
					const data = await res.json().catch(() => ({}));
					if (!res.ok || !data.lobby) {
						throw new Error(data.message || 'Could not create the lobby.');
					}
					window.location = `/game?code=${data.lobby.code}`;
				} catch (error) {
					setLobbyStatus(error.message || 'Could not create the lobby.', true);
					createButton.disabled = false;
					randomLobbyButton.disabled = false;
				}
			}

			document
				.getElementById('create-button')
				.addEventListener('click', async (e) => {
					await createLobbyAndRedirect();
				});

			randomLobbyButton.addEventListener('click', async (e) => {
				randomLobbyButton.disabled = true;
				try {
					setLobbyStatus('Finding an open match...');
					const res = await fetch('/api/matchmaking', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' }
					});
					if (!res.ok) throw new Error('Matchmaking is temporarily unavailable.');
					const { lobby } = await res.json();
					if (!lobby?.code) throw new Error('No playable lobby was returned.');
					join(lobby.code);
				} catch (error) {
					setLobbyStatus(error.message || 'Matchmaking failed.', true);
					randomLobbyButton.disabled = false;
				}
			});

			const codeField = document.getElementById('code-field');
			document.getElementById('join-button').addEventListener('click', (e) => {
				const code = codeField.value.trim().toUpperCase();
				if (!/^[A-Z0-9]{5}$/.test(code)) {
					setLobbyStatus('Enter a five-character join code.', true);
					return;
				}
				window.location = `/game?code=${encodeURIComponent(code)}`;
			});
			codeField.addEventListener('input', () => {
				codeField.value = codeField.value.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 5);
			});

			function join(code) {
				window.location = `/game?code=${encodeURIComponent(code)}`;
			}

			const lobbiesContainer = document.getElementById('lobbies-container');
			function refreshLobbies() {
				fetch('/api/lobbies', { cache: 'no-store' })
					.then((res) => {
						if (!res.ok) throw new Error('Could not refresh open lobbies.');
						return res.json();
					})
					.then((res) => res.lobbies)
					.then((lobbies) => {
						if (lobbies.length) {
							lobbiesContainer.innerHTML = `<ul class="lobbies">${
								lobbies.map((lobby) => `
									<li class="lobby">
										<div>
										<div><strong>${escapeHtml(lobby.name)} (${escapeHtml(lobby.code)})</strong></div>
											<div>Players: ${lobby.playerCount}/2 · Spectators: ${lobby.spectatorCount}</div>
										</div>

										<button onclick="join('${lobby.code}')">${lobby.joinableAsPlayer ? "Join" : "Spectate"}</button>
									</li>
								`).join('\n')
							}</ul>`;
						} else {
							lobbiesContainer.innerHTML = '<p>No lobbies open currently.</p>';
						}
					})
					.catch((error) => {
						lobbiesContainer.innerHTML = `<p class="error">${escapeHtml(error.message)}</p>`;
					});
			}

			refreshLobbies();
			setInterval(() => {
				if (!document.hidden) refreshLobbies();
			}, 5000);
			<% } %>
		</script>
	</body>
</html>
